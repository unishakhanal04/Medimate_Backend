PORT=5000
HOST=0.0.0.0
MONGO_URI=mongodb://localhost:27017/medimate
JWT_SECRET=changeme_secret
JWT_EXPIRES_IN=7d

# Required for the forgot-password OTP email. Use a Gmail App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords),
# not your normal Gmail login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=MediMate <your-gmail-address@gmail.com>

FRONTEND_URL=http://localhost:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Required for "Sign in with Google". Create an OAuth 2.0 Client ID at
# https://console.cloud.google.com/apis/credentials (Web application type),
# add FRONTEND_URL above to "Authorized JavaScript origins", then set the
# SAME client ID here and as NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend's
# .env.local. Without it, the Google sign-in button simply won't render.
GOOGLE_CLIENT_ID=

# eSewa v2 sandbox — the values below are eSewa's own public test-merchant
# credentials (EPAYTEST), safe to keep as-is; they only work against eSewa's
# rc- (sandbox) endpoints, never production.
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
PREMIUM_PRICE_NPR=999
PREMIUM_DURATION_DAYS=30
FREE_AI_MESSAGE_LIMIT=20

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@medimate.local
