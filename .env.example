PORT=5000
HOST=0.0.0.0
MONGO_URI=mongodb://localhost:27017/medimate
JWT_SECRET=changeme_secret
JWT_EXPIRES_IN=7d

# Required for the forgot-password OTP email. Use a Gmail App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords),
# not your normal Gmail login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=MediMate <your-gmail-address@gmail.com>

FRONTEND_URL=http://localhost:3000

# Required for the AI Assistant. Get a free key at https://aistudio.google.com/apikey
# (Google AI Studio -> Get API key). Without it, AI chat requests fail with a clear
# "AI features are not configured" error instead of a generic 500.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Required for "Sign in with Google". Create an OAuth 2.0 Client ID at
# https://console.cloud.google.com/apis/credentials (Web application type),
# add FRONTEND_URL above to "Authorized JavaScript origins", then set the
# SAME client ID here and as NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend's
# .env.local. Without it, the Google sign-in button simply won't render.
GOOGLE_CLIENT_ID=

# Required for browser push notifications. Generate your own keypair with:
#   npx web-push generate-vapid-keys
# then paste the two values below. VAPID_SUBJECT should be a mailto: or https:
# URL identifying you, sent to push services as contact info if something's wrong.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@medimate.local
